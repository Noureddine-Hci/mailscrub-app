# MailScrub.app — Environment Variables
# Copy this file to .env and fill in your values

# Google OAuth 2.0 credentials (from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials?project=mailscrub-app
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Microsoft OAuth 2.0 credentials (Azure App Registration, tenant "common" —
# couvre comptes personnels outlook.com/hotmail et comptes pro Microsoft 365)
# https://portal.azure.com -> Microsoft Entra ID -> App registrations
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret

# Session secret key (used to sign cookies, et à dériver la clé de chiffrement
# des mots de passe IMAP/POP en session — voir backend/src/security/crypto.py)
# Generate a random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key
