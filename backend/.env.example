# MailScrub.app — Environment Variables
# Copy this file to .env and fill in your values

# Google OAuth 2.0 credentials (from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials?project=mailscrub-app
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Session secret key (used to sign cookies)
# Generate a random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key
